#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is required." >&2
  exit 1
fi

if [ ! -x "$VENV_DIR/bin/python" ]; then
  python3 -m venv "$VENV_DIR"
fi

if [ ! -f "$VENV_DIR/.deps-installed" ] || [ "$SCRIPT_DIR/requirements.txt" -nt "$VENV_DIR/.deps-installed" ]; then
  PIP_NO_CACHE_DIR=1 "$VENV_DIR/bin/pip" install --upgrade pip >/dev/null
  PIP_NO_CACHE_DIR=1 "$VENV_DIR/bin/pip" install -r "$SCRIPT_DIR/requirements.txt" >/dev/null
  touch "$VENV_DIR/.deps-installed"
fi

exec "$VENV_DIR/bin/python" "$SCRIPT_DIR/tts_cli.py" "$@"
